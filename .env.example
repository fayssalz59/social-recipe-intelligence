# Snowflake
SNOWFLAKE_USER=your_snowflake_user
SNOWFLAKE_PASSWORD=your_snowflake_password
SNOWFLAKE_ACCOUNT=your_account_identifier
SNOWFLAKE_WAREHOUSE=PORTFOLIO_WH
SNOWFLAKE_DB=TIKTOK_PORTFOLIO_DB
SNOWFLAKE_SCHEMA_BRONZE=BRONZE
SNOWFLAKE_SCHEMA_SILVER=SILVER
SNOWFLAKE_SCHEMA_GOLD=GOLD
SNOWFLAKE_ROLE=agent_role

# OpenRouter / LLM enrichment
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=google/gemini-2.0-flash-001
OPENROUTER_HTTP_REFERER=http://localhost
OPENROUTER_APP_NAME=TikTok Recipe Intelligence Pipeline

# Kafka
# Use kafka:29092 from Docker containers and localhost:19092 from the host.
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_TOPIC_NEW_VIDEOS=new_tiktok_video_detected

# TikTok monitor
# Optional. TikTok scraping may require a fresh token and headed browser behavior.
TIKTOK_MS_TOKEN=
RECOVERY_MEDIA_CACHE_DIR=/root/.cache/recipe-content-recovery/media

# Airflow
# On Linux servers, set this to the host user id that owns the repo:
# AIRFLOW_UID=$(id -u)
AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR=..
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin

# Logging
LOG_LEVEL=INFO
SNOWFLAKE_LOG_LEVEL=WARNING
DEPENDENCY_LOG_LEVEL=WARNING
